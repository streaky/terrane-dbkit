namespace terrane/dbkit/sqlite

from /deps/sqlx-sqlite import SqliteConnectOptions, SqliteConnection
from /deps/sqlx-sqlite/sqliteconnectoptions import connect
from /deps/sqlx-sqlite/sqliteconnection import close as close-native

public class config
    path string = ':memory:'
    create-if-missing bool = true

    function construct; path string = ':memory:', create-if-missing bool = true
        this.path = path
        this.create-if-missing = create-if-missing

public class statement
    sql string = ''
    bound-bytes bytes = b''
    has-binding bool = false

    function construct; sql string
        this.sql = sql

    mutable function bind-bytes; value bytes
        this.bound-bytes = value
        this.has-binding = true

public function prepare statement; sql string
    return instance statement; sql

public class connection
    native SqliteConnection|none = none

    function construct; native SqliteConnection
        this.native = move native

    public function is-open bool;
        return this.native != none

    public mutable async function close;
        native = move this.native
        if native != none
            await close-native; move native

    function destruct;
        await this.close;

public async function open connection; settings config
    options = SqliteConnectOptions::new;
    options = options.filename; settings.path
    options = options.create_if_missing; settings.create-if-missing
    native = await connect; options
    return instance connection; move native
