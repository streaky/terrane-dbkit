namespace app

from /app/assertions import assert-equal-int, assert-equal-string, assert-equal-bool
from /streaky/dbkit import config, connect, database-error, error-details, statement as database-statement, integer-value, real-value, text-value, bytes-value, bool-value, null-value

async function expect-postgres-bind-failure; prepared shared ref database-statement
    rejected bool = false
    try
        await prepared.query;
    catch database-error as failure
        details = error-details; failure
        assert-equal-string; details.code, 'conversion'
        assert-equal-string; details.driver, 'postgres'
        assert-equal-string; details.operation, 'bind'
        rejected = true
    assert-equal-bool; rejected, true

async function postgres-parameter-types-scenario; dsn string
    database = await connect; (instance config; 'postgres', dsn)
    prepared = await database.prepare; 'SELECT :small::SMALLINT, :ordinary::INTEGER, :real::REAL, :flag::BOOL, :note::TEXT, :payload::BYTEA, :opaque::UUID'
    prepared.bind; 'small', (integer-value; -32768)
    prepared.bind; 'ordinary', (integer-value; 2147483647)
    prepared.bind; 'real', (real-value; 1.5)
    prepared.bind; 'flag', (bool-value; true)
    prepared.bind; 'note', (text-value; 'snowman ☃')
    prepared.bind; 'payload', (bytes-value; b'\0\xff')
    prepared.bind; 'opaque', (null-value;)
    rows = await prepared.query;
    record = rows.fetch;
    if record != none
        assert-equal-int; ((record.get; 0).as-integer;), -32768
        assert-equal-int; ((record.get; 1).as-integer;), 2147483647
        assert-equal-bool; ((record.get; 2).as-real;) == 1.5, true
        assert-equal-bool; ((record.get; 3).as-bool;), true
        assert-equal-string; ((record.get; 4).as-text;), 'snowman ☃'
        assert-equal-bool; ((record.get; 5).as-bytes;) == b'\0\xff', true
        assert-equal-bool; ((record.get; 6).is-null;), true
        wrong-kind bool = false
        try
            (record.get; 0).as-text;
        catch database-error as failure
            assert-equal-string; (error-details; failure).code, 'conversion'
            assert-equal-string; (error-details; failure).driver, 'postgres'
            wrong-kind = true
        assert-equal-bool; wrong-kind, true
    else
        throw scenario-failure
    prepared.clear-bindings;
    prepared.bind; 'small', (null-value;)
    prepared.bind; 'ordinary', (null-value;)
    prepared.bind; 'real', (null-value;)
    prepared.bind; 'flag', (null-value;)
    prepared.bind; 'note', (null-value;)
    prepared.bind; 'payload', (null-value;)
    prepared.bind; 'opaque', (null-value;)
    rows = await prepared.query;
    record = rows.fetch;
    if record != none
        index int = 0
        while index < 7
            assert-equal-bool; ((record.get; index).is-null;), true
            index = index + 1
    else
        throw scenario-failure
    prepared.bind; 'small', (integer-value; 32768)
    await expect-postgres-bind-failure; prepared
    prepared.bind; 'small', (integer-value; -32769)
    await expect-postgres-bind-failure; prepared
    prepared.bind; 'small', (integer-value; 32767)
    prepared.bind; 'ordinary', (integer-value; 2147483648)
    await expect-postgres-bind-failure; prepared
    prepared.bind; 'ordinary', (integer-value; -2147483649)
    await expect-postgres-bind-failure; prepared
    prepared.bind; 'ordinary', (integer-value; -2147483648)
    prepared.bind; 'real', (real-value; 10000000000000000000000000000000000000000.0)
    await expect-postgres-bind-failure; prepared
    prepared.bind; 'real', (real-value; 3.5)
    rows = await prepared.query;
    record = rows.fetch;
    if record != none
        assert-equal-int; ((record.get; 0).as-integer;), 32767
        assert-equal-int; ((record.get; 1).as-integer;), -2147483648
        assert-equal-bool; ((record.get; 2).as-real;) == 3.5, true
    else
        throw scenario-failure
    prepared.close;
    await database.close;
    print; 'postgres-parameter-types=true'
