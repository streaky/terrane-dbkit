namespace terrane/dbkit/sqlite

from /core/testing import assert-equal-string

function test-prepared-statement-retains-sql;
    prepared = prepare; 'SELECT 1'
    assert-equal-string; prepared.sql, 'SELECT 1'

function test-prepared-statement-bind-bytes-sets-binding;
    prepared = prepare; 'SELECT 1 WHERE ? = ?'
    prepared.bind-bytes; b'value'
    assert-equal-string; prepared.sql, 'SELECT 1 WHERE ? = ?'
